PetalburgCity_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, PetalburgCity_OnTransition
	map_script MAP_SCRIPT_ON_FRAME_TABLE, PetalburgCity_OnFrame
	.byte 0

PetalburgCity_OnTransition:
	setflag FLAG_VISITED_PETALBURG_CITY
	@ Phase 10 (docs/SPEC.md "Petalburg/Wally tutorial"): Wally's catching tutorial
	@ is removed and the player never has to talk to Norman in this arc. The old
	@ VAR_PETALBURG_CITY_STATE==0 branch only parked the gym-boy escort at the west
	@ entrance; the escort is cut too (see below). On the first visit, fast-forward
	@ every side effect the vanilla Wally scene carried.
	call_if_eq VAR_PETALBURG_GYM_STATE, 0, PetalburgCity_EventScript_SkipWallyIntro
	call_if_eq VAR_PETALBURG_CITY_STATE, 4, PetalburgCity_EventScript_DisableMapNameAndMusic
	call_if_eq VAR_PETALBURG_GYM_STATE, 8, PetalburgCity_EventScript_SetGymDoorsUnlocked
	end

@ Phase 10 (docs/SPEC.md "Petalburg/Wally tutorial"). Mirrors what
@ PetalburgCity_EventScript_WallyTutorial + PetalburgCity_Gym_EventScript_BeginWallyTutorial
@ did, minus the cutscene:
@   - VAR_PETALBURG_GYM_STATE 2 = "Norman has no badges yet" (his story gate; every
@     gym does `addvar VAR_PETALBURG_GYM_STATE, 1`, and the Gym reserves value 1 for
@     "Wally tutorial in progress", so it must never be left at 0).
@   - VAR_PETALBURG_CITY_STATE 3 = terminal idle (same value the vanilla scene set).
@   - InitBirchState starts Prof. Birch's daily wander (prof_birch.inc no-ops while
@     VAR_PETALBURG_GYM_STATE == 0).
@   - the two FLAG_HIDE_* were set by the Gym scene.
PetalburgCity_EventScript_SkipWallyIntro::
	setvar VAR_PETALBURG_GYM_STATE, 2
	setvar VAR_PETALBURG_CITY_STATE, 3
	special InitBirchState
	setflag FLAG_HIDE_LITTLEROOT_TOWN_BIRCHS_LAB_RIVAL
	setflag FLAG_HIDE_PETALBURG_CITY_WALLYS_MOM
	return

PetalburgCity_EventScript_DisableMapNameAndMusic::
	setflag FLAG_HIDE_MAP_NAME_POPUP
	savebgm MUS_FOLLOW_ME
	return

PetalburgCity_EventScript_SetGymDoorsUnlocked::
	setvar VAR_PETALBURG_GYM_STATE, 7
	return

PetalburgCity_OnFrame:
	map_script_2 VAR_PETALBURG_CITY_STATE, 4, PetalburgCity_EventScript_WalkToWallyHouse
	.2byte 0

PetalburgCity_EventScript_WalkToWallyHouse::
	lockall
	setflag FLAG_HIDE_MAP_NAME_POPUP
	applymovement LOCALID_PETALBURG_WALLYS_DAD, PetalburgCity_Movement_WalkToWallyHouseWallysDad
	applymovement LOCALID_PLAYER, PetalburgCity_Movement_WalkToWallyHousePlayer
	waitmovement 0
	setvar VAR_0x8004, 7
	setvar VAR_0x8005, 5
	opendoor VAR_0x8004, VAR_0x8005
	waitdooranim
	applymovement LOCALID_PETALBURG_WALLYS_DAD, PetalburgCity_Movement_WalkInsideHouseWallysDad
	applymovement LOCALID_PLAYER, PetalburgCity_Movement_WalkInsideHousePlayer
	waitmovement 0
	setflag FLAG_HIDE_PETALBURG_CITY_WALLYS_DAD
	hideobjectat LOCALID_PLAYER, MAP_PETALBURG_CITY
	closedoor VAR_0x8004, VAR_0x8005
	waitdooranim
	clearflag FLAG_HIDE_MAP_NAME_POPUP
	fadedefaultbgm
	clearflag FLAG_DONT_TRANSITION_MUSIC
	warp MAP_PETALBURG_CITY_WALLYS_HOUSE, 2, 4
	waitstate
	releaseall
	end

